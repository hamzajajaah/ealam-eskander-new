}
.profile p{color:var(--muted);line-height:1.7}
.clock-card{
  background:var(--card);border:1px solid #333;
  border-radius:16px;padding:20px;text-align:center;
}
.clock{
  width:150px;height:150px;border:5px solid #a90c24;
  border-radius:50%;margin:10px auto 18px;
  position:relative;background:radial-gradient(#242424,#080808);
  box-shadow:0 0 25px #e5092530;
}
.clock:after{
  content:"";position:absolute;width:9px;height:9px;
  background:white;border-radius:50%;left:calc(50% - 4.5px);
  top:calc(50% - 4.5px);z-index:5;
}
.hand{
  position:absolute;bottom:50%;left:50%;
  transform-origin:bottom;border-radius:5px;
}
.hour{width:5px;height:38px;background:white}
.minute{width:3px;height:54px;background:#ff4059}
.second{width:2px;height:59px;background:#e50925}
.cards{
