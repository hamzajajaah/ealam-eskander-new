<script>
function toggleMenu(){
  document.getElementById("nav").classList.toggle("show");
}

// واجهة دخول تجريبية فقط وليست نظام حسابات آمن
function login(){
  const user=document.getElementById("username").value.trim();
  const pass=document.getElementById("password").value;
  const msg=document.getElementById("loginMessage");

  if(!user || !pass){
    msg.textContent="من فضلك اكتب اسم المستخدم وكلمة المرور";
    return;
  }

  sessionStorage.setItem("demoUser",user);
  msg.textContent="تم تسجيل الدخول للواجهة التجريبية باسم "+user;
}

function logout(){
  sessionStorage.removeItem("demoUser");
  document.getElementById("loginMessage").textContent="تم تسجيل الخروج";
  document.getElementById("password").value="";
}

const courses={
  programming:{
    title:"تعليم البرمجة",
    price:"200 جنيه",
    description:"تعلم أساسيات البرمجة وتصميم صفحات الويب باستخدام HTML وCSS وJavaScript، بالإضافة إلى مقدمة في Python."
  },
  termux:{
    title:"تعليم Termux",
    price:"500 جنيه",
    description:"تعلم أساسيات Linux والطرفية وإدارة الملفات وأدوات البرمجة والاستخدامات التعليمية الآمنة."
  },
  trading:{
    title:"تعليم التداول",
    price:"700 جنيه",
    description:"تعرف على مفاهيم الأسواق المالية والتحليل وإدارة المخاطر. المحتوى تعليمي ولا يضمن أرباحًا."
  }
};

function openCourse(name){
  const course=courses[name];
  document.getElementById("courseTitle").textContent=course.title;
  document.getElementById("courseDescription").textContent=course.description;
  document.getElementById("coursePrice").textContent=course.price;
  document.getElementById("coursePanel").classList.add("active");
  document.getElementById("coursePanel").scrollIntoView({behavior:"smooth"});
}

function closeCourse(){
  document.getElementById("coursePanel").classList.remove("active");
}

// ساعة عقارب بتوقيت القاهرة
function updateClock(){
  const now=new Date();
  const parts=new Intl.DateTimeFormat("en-US",{
    timeZone:"Africa/Cairo",
    hour:"2-digit",minute:"2-digit",second:"2-digit",
    hour12:false
  }).formatToParts(now);

  const get=(type)=>Number(parts.find(p=>p.type===type).value);
  const h=get("hour"),m=get("minute"),s=get("second");

  document.getElementById("hour").style.transform=
    `translateX(-50%) rotate(${(h%12)*30+m*.5}deg)`;
  document.getElementById("minute").style.transform=
    `translateX(-50%) rotate(${m*6+s*.1}deg)`;
  document.getElementById("second").style.transform=
    `translateX(-50%) rotate(${s*6}deg)`;

  document.getElementById("digital").textContent=
    [h,m,s].map(v=>String(v).padStart(2,"0")).join(":");

  document.getElementById("date").textContent=
    new Intl.DateTimeFormat("ar-EG",{
      timeZone:"Africa/Cairo",
      weekday:"long",year:"numeric",month:"long",day:"numeric"
    }).format(now);
}

updateClock();
setInterval(updateClock,1000);
</script>

